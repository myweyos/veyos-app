{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "services/api/src/main",
  "compilerOptions": {
    "assets": [{ "include": "database/migrations/*.sql", "outDir": "dist/services/api/src" }],
    "deleteOutDir": true
  }
}
