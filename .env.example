# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# WEYOS ONLY. Create this token from the Atlassian account that owns the Weyos site — not
# from an account used for any other company. A Jira API token authenticates as the whole
# user across every site that account can reach, so using the wrong one would quietly give
# this repo's tooling access to unrelated organisations.
#
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
# Revoke there too, and treat it as compromised the moment it leaves this machine.

# Your Weyos Atlassian site, no trailing slash.
JIRA_BASE_URL=https://your-weyos-site.atlassian.net

# The email address of the Atlassian account the token belongs to.
JIRA_EMAIL=you@example.com

# The API token itself. Never paste this into a chat, a commit, a log or a ticket.
JIRA_API_TOKEN=

# Optional. The project key to work against, e.g. WEY. Leave blank to list what is visible.
JIRA_PROJECT_KEY=
