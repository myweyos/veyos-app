{
  "name": "weyos",
  "version": "0.1.0",
  "private": true,
  "description": "Weyos monorepo",
  "workspaces": [
    "packages/*",
    "services/api",
    "apps/mobile"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
