{
  "name": "@weyos/shared-schema",
  "version": "1.1.0",
  "private": true,
  "description": "The Weyos contract. JSON Schema is the source of truth; TS types are its projection.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "schemas"
  ],
  "scripts": {
    "generate": "node scripts/generate.js",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.6.0"
  }
}
