{
  "expo": {
    "name": "Weyos",
    "slug": "weyos",
    "scheme": "weyos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.weyos.client",
      "supportsTablet": false,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Weyos reads your heart-rate variability, resting heart rate, sleep and temperature to decide what your body needs today.",
        "NSHealthUpdateUsageDescription": "Weyos writes completed sessions back to Health so your record stays in one place.",
        "NSBluetoothAlwaysUsageDescription": "Weyos connects to your chest strap for real-time heart-rate variability.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "fetch",
          "processing"
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "app.weyos.client",
      "permissions": [
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_MENSTRUATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-health-connect",
      "./plugins/withHealthConnectPermissionDelegate",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "$comment": "Runtime config comes from EXPO_PUBLIC_* variables set per build profile in eas.json: EXPO_PUBLIC_API_BASE_URL, EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY. The anon key is public by design; the service-role key must never be here.",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "58b5b2d9-a951-41be-97d6-c18c3c9447b7"
      }
    },
    "owner": "robert-qordev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/58b5b2d9-a951-41be-97d6-c18c3c9447b7"
    }
  }
}
