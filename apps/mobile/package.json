{
  "name": "@weyos/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@supabase/supabase-js": "2.116.0",
    "@weyos/app-state": "*",
    "expo": "~51.0.0",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.0",
    "expo-dev-client": "~4.0.29",
    "expo-health-connect": "0.1.1",
    "expo-linking": "~6.3.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.0",
    "expo-updates": "~0.25.28",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-health-connect": "2.2.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  },
  "$comment": "Sensors are added one at a time, each proven by a dev build on a physical device. Health Connect (react-native-health-connect 2.2.0, the RN 0.74 line, + expo-health-connect) is the first. Still to come: HealthKit (needs Apple enrolment, SCRUM-23), react-native-ble-plx (VEY-SENSOR-2), expo-background-fetch + expo-task-manager (VEY-SENSOR-3)."
}
